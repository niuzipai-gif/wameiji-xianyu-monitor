# ===== 主 AI（MiniMax M3 多模态） =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL_NAME=MiniMax-Text-01
# 改成你们后台实际显示的 M3 model id
# OPENAI_MODEL_NAME=MiniMax-M3

# ===== 备用 AI（DeepSeek 纯文本） =====
FALLBACK_AI_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# ===== 运行时 =====
RUN_HEADLESS=true
LOGIN_IS_EDGE=false
RUNNING_IN_DOCKER=false
PCURL_TO_MOBILE=true
SKIP_AI_ANALYSIS=false
AI_DEBUG_MODE=false
ENABLE_RESPONSE_FORMAT=true
ENABLE_THINKING=false

# ===== 服务 =====
SERVER_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=admin123
TASK_LOG_RETENTION_DAYS=7

# ===== 登录态 / 多账号 =====
STATE_FILE=data/xianyu_state.json
ACCOUNT_STATE_DIR=data/state
ACCOUNT_ROTATION_ENABLED=false
ACCOUNT_ROTATION_MODE=per_task
ACCOUNT_ROTATION_RETRY_LIMIT=2
ACCOUNT_BLACKLIST_TTL=300

# ===== 代理轮换（默认关闭） =====
PROXY_ROTATION_ENABLED=false
PROXY_POOL=
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300

# ===== 失败保护 =====
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=600

# ===== 并发 / 缓存 =====
IMAGE_DOWNLOAD_CONCURRENCY=3
AI_ANALYSIS_CONCURRENCY=2
SELLER_PROFILE_CACHE_TTL=1800

# ===== 通知 =====
# NTFY_TOPIC_URL=
# GOTIFY_URL=
# GOTIFY_TOKEN=
# BARK_URL=
# WX_BOT_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FEISHU_WEBHOOK_URL=
# DINGTALK_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=
# DINGTALK_WEBHOOK_SECRET=
# WEBHOOK_URL=
WEBHOOK_METHOD=POST
WEBHOOK_CONTENT_TYPE=JSON

# ===== 业务层（CD Monitor） =====
CD_DB_PATH=data/cd_monitor.db
CD_CONFIG_PATH=config.yaml
CD_SNAPSHOT_DIR=data/snapshots
CD_SCREENSHOT_DIR=data/screenshots
CD_IMAGE_DIR=data/images

# ===== Hosted UI / Render (leave blank locally unless using remote UI) =====
WEB_ALLOWED_ORIGINS=
WEB_ACCESS_TOKEN=
CD_SYNC_TOKEN=
CD_REPLICA_URL=

CD_PROFIT_MARGIN_MIN=0.15
CD_ROI_MIN=0.20
CD_XIANYU_SAMPLE_LIMIT=20
CD_XIANYU_MIN_PRICE=5.0
CD_XIANYU_MAX_PRICE=20000.0
CD_MATCH_CONFIDENCE=0.55
CD_WEAK_ALERT_THRESHOLD=0.08
CD_STRONG_ALERT_THRESHOLD=0.20
CD_JPY_TO_CNY=0.05
CD_INTL_SHIPPING=80.0
CD_CUSTOMS_RATE=0.10
